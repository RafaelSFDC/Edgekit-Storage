{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/f/*",
      "/private/*",
      "/upload",
      "/upload/*",
      "/health"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cloudflare-storage-bucket",
      "preview_bucket_name": "cloudflare-storage-bucket-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgekit-storage-db",
      "database_id": "edgekit-storage-db"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "vars": {
    "PUBLIC_URL": "",
    "ALLOWED_MIME_TYPES": "image/*,application/pdf",
    "MAX_FILE_SIZE_MB": "25",
    "ENABLE_WORKER_FALLBACK_STREAM": "true",
    "ALLOWED_ORIGINS": ""
  }
}
