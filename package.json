{
  "name": "edgekit-storage",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Lightweight open-source image and file storage backend for Cloudflare Workers & R2 — EdgeKit Storage",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"pnpm --filter @edgekit/api dev\" \"pnpm --filter @edgekit/web dev\"",
    "dev:api": "pnpm --filter @edgekit/api dev",
    "dev:web": "pnpm --filter @edgekit/web dev",
    "setup": "node scripts/setup.mjs",
    "build:web": "pnpm --filter @edgekit/web build",
    "build:api": "pnpm --filter @edgekit/api build",
    "build": "pnpm --filter @edgekit/web build && pnpm --filter @edgekit/api build",
    "deploy": "pnpm --filter @edgekit/web build && pnpm --filter @edgekit/api deploy",
    "cf-typegen": "pnpm --filter @edgekit/api cf-typegen",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:vitest": "pnpm -r run test:vitest",
    "test:e2e": "playwright test",
    "test:api": "pnpm --filter @edgekit/api test",
    "test:web": "pnpm --filter @edgekit/web test",
    "lint": "oxlint"
  },
  "keywords": [
    "cloudflare",
    "r2",
    "workers",
    "storage",
    "hono",
    "edgekit"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.1.2",
    "oxc-transform-react": "0.156.0",
    "oxlint": "^1.90.0"
  }
}
