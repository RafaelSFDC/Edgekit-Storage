{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cloudflare-storage-bucket",
      "preview_bucket_name": "cloudflare-storage-bucket-preview"
    }
  ],
  "vars": {
    // URL pública direta do R2 (ex: seu domínio customizado no R2 ou r2.dev)
    // Exemplo: "https://media.seudominio.com" ou "https://pub-xxxx.r2.dev"
    // Se vazio, usará a URL do próprio worker (/f/:key) como fallback
    "PUBLIC_URL": "",

    // Tipos de arquivos permitidos separados por vírgula.
    // Use "*" para permitir qualquer tipo.
    // Suporta curingas como "image/*" ou tipos específicos como "image/jpeg,image/png,application/pdf"
    "ALLOWED_MIME_TYPES": "image/*,application/pdf",

    // Tamanho máximo do arquivo em Megabytes
    "MAX_FILE_SIZE_MB": "25",

    // Permite servir arquivos via Worker (/f/:key) como fallback caso não utilize Custom Domain
    "ENABLE_WORKER_FALLBACK_STREAM": "true"
  }
}
