# Secret API Key to authenticate upload, list, and delete requests
API_KEY=your-strong-secret-key-here

# Public URL configured in R2 (Custom Domain or r2.dev subdomain)
# Example: https://media.yourdomain.com or https://pub-xxxxxx.r2.dev
PUBLIC_URL=http://localhost:8787/f

# Allowed MIME types (* for all, or comma-separated list like image/*,application/pdf)
ALLOWED_MIME_TYPES=image/*,application/pdf

# Maximum file size limit in Megabytes
MAX_FILE_SIZE_MB=25

# Enable Worker fallback streaming
ENABLE_WORKER_FALLBACK_STREAM=true

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
